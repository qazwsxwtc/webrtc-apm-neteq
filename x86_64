message(STATUS "====== Platform + Arch Detection Matrix ======")

set(WIN32 TRUE)
set(APPLE FALSE)
set(ANDROID FALSE)
set(UNIX FALSE)
set(_proc "AMD64")
set(_arch_check "")
if(APPLE)
    if(_proc MATCHES "arm64|aarch64|ARM64")
        set(_arch_check "arm64")
    else()
        set(_arch_check "x86_64")
    endif()
else()
    set(_arch_check ${_proc})
endif()
set(_arch_out "UNKNOWN")
if(_arch_check MATCHES "x86_64|AMD64|amd64|X86_64")
    set(_arch_out "x86_64")
elseif(_arch_check MATCHES "x86|i[3-6]86")
    set(_arch_out "x86")
elseif(_arch_check MATCHES "aarch64|arm64|ARM64|arm64-v8a")
    set(_arch_out "arm64")
elseif(_arch_check MATCHES "arm|ARM|armeabi-v7a|armv7")
    set(_arch_out "armv7")
endif()
set(_simd "none")
if(_arch_out MATCHES "arm")
    set(_simd "NEON")
elseif(_arch_out MATCHES "x86")
    set(_simd "SSE2")
endif()
message("  ✅ win-x64            os=Windows  arch=${_arch_out,-6} simd=${_simd}")

